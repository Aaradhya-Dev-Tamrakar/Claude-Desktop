# Copy this file to .env and fill in the values you want to use.
# Do not commit your real .env file to source control.

# Core app settings
API_AUTH_KEY=dev-secret-key-change-in-prod

# Worker daemon settings
# Claude handles the high-level reasoning/task creation in separate desktop accounts.
# Groq is used here as the execution worker for research, writing, QA, seo, formatting.
ORCHESTRATOR_URL=http://localhost:8000/api/v1
NODE_ID=local-node-01
WORKER_ID=groq_worker_01
PROVIDER=groq
CDP_PORT=9222
CLAUDE_CDP_PORT=9222

# LLM provider credentials
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
# Default executor: fast and cheap. Switch to llama-3.3-70b-versatile for higher-quality drafts/QA if needed.
GROQ_MODEL=llama-3.1-8b-instant

# Optional: if you are using a local Claude desktop proxy/profile
# CLAUDE_DESKTOP_PROFILE_PATH=
